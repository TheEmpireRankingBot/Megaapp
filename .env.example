# Local development needs no variables: Megaapp uses PGlite and automatic single-user access.
# Optional: PGLITE_DATA_DIR=.pglite-alpha isolates a local acceptance database.
# For deployment, only the external Postgres connection is required.
DATABASE_URL=postgres://postgres.PROJECT_REF:PASSWORD@HOST:5432/postgres

# Web Push notifications. Generate one VAPID key pair with:
# npx web-push generate-vapid-keys --json
NEXT_PUBLIC_VAPID_PUBLIC_KEY=REPLACE_ME
VAPID_PRIVATE_KEY=REPLACE_ME
VAPID_SUBJECT=mailto:you@example.com

# Random value of at least 16 characters. Vercel sends it to the cron route.
CRON_SECRET=REPLACE_WITH_A_LONG_RANDOM_VALUE

# Optional: enables provider-backed Assistant answers. Local briefings work without it.
OPENAI_API_KEY=REPLACE_ME
# OPENAI_MODEL=gpt-5.4-mini
